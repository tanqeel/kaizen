DATABASE_URL="file:./dev.db"

# ── Kaizen AI provider layer (free, pluggable — priority order below) ──
# Override priority: AI_PROVIDER_ORDER="ollama,pollinations,huggingface,gemini"
# 1. Ollama (local open-source models, no key needed)
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"
# 2. Pollinations (free public gateway, open-source models, NO key needed — active by default)
# POLLINATIONS_MODEL="openai-fast"
# POLLINATIONS_DISABLED="1"   # uncomment to turn the free provider off
# 3. Hugging Face Inference API (free-tier token, open models)
# HF_TOKEN=""
# HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
# 4. Gemini (free tier)
# GEMINI_API_KEY=""
