// Kaizen School Management System — data model
// Postgres via Prisma (Neon on Vercel for production; any Postgres URL works locally).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  ADMIN
  TEACHER
  STAFF
  PARENT
  STUDENT
}

enum AccountStatus {
  PENDING
  VERIFICATION_REQUIRED
  APPROVED
  ACTIVE
  SUSPENDED
  LOCKED
  REJECTED
  DEACTIVATED
  GRADUATED
  TRANSFERRED
}

enum StaffType {
  TEACHING
  ACCOUNTANT
  OFFICE
  SECURITY
  PEON
  SANITARY
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PENDING
}

enum CheckInMethod {
  FINGERPRINT
  FACE
  RFID
  MANUAL
}

enum ConflictType {
  GATE_PRESENT_LECTURE_ABSENT
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum VoucherStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  KUICKPAY_1LINK
  JAZZCASH
  EASYPAISA
}

enum AnnouncementPriority {
  NORMAL
  URGENT
}

enum AnnouncementAudience {
  ALL
  PARENTS
  STAFF
  TEACHERS
  GRADES
}

enum NotificationType {
  ARRIVAL
  DEPARTURE
  LECTURE_ABSENCE
  FEE_REMINDER
  ANNOUNCEMENT
}

enum NotificationChannel {
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  SENT
  FAILED
}

enum TerminalStatus {
  ONLINE
  OFFLINE
}

// ── Core ─────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Asia/Karachi")
  createdAt DateTime @default(now())

  sessions              AcademicSession[]
  shifts                Shift[]
  grades                Grade[]
  subjects              Subject[]
  feeHeads              FeeHead[]
  announcements         Announcement[]
  smsTemplates          SmsTemplate[]
  terminals             BiometricTerminal[]
  expenses              Expense[]
  budgets               Budget[]
  expenseHeads          ExpenseHead[]
  paymentSources        PaymentSource[]
  payslips              Payslip[]
  expenseRequests       ExpenseRequest[]
  diaryEntries          DiaryEntry[]
  studyMaterials        StudyMaterial[]
  admissionApplications AdmissionApplication[]
  leaveRequests         LeaveRequest[]
  staffAttendance       StaffAttendance[]
  schoolEvents          SchoolEvent[]
  feePolicy             FeePolicy?
  auditLogs             AuditLog[]
  registrationRequests  RegistrationRequest[]
  intelligenceInsights  IntelligenceInsight[]
  liveClasses           LiveClass[]
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String // "2025-26"
  term      String // "Fall" | "Spring"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  students  Student[]
  examTerms ExamTerm[]
  vouchers  FeeVoucher[]
  budgets   Budget[]
}

model Shift {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String // "Morning" | "Evening"

  students Student[]
}

model User {
  id           String        @id @default(cuid())
  kaizenId     String?       @unique // KZN-XXX-YYYY-NNNNNN; assigned on approval/creation
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  phone        String?
  cnic         String?
  isActive     Boolean       @default(true)
  status       AccountStatus @default(ACTIVE)
  forcePasswordReset Boolean @default(false) // Admin can require password change on next login
  createdAt    DateTime      @default(now())

  sessions              SessionToken[]
  teacher               Teacher?
  staffMember           StaffMember?
  parent                Parent?
  student               Student?
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  notifications         NotificationLog[]
  expensesAdded         Expense[]              @relation("ExpenseAuthor")
  paymentsReceived      Payment[]              @relation("PaymentReceiver")
  attendanceMarked      PeriodAttendance[]     @relation("AttendanceMarker")
  gateCheckInsCreated   GateCheckIn[]          @relation("GateCheckInCreator")
  conflictsResolved     AttendanceConflict[]   @relation("ConflictResolver")
  aiConversations       AiConversation[]
  aiUsageLogs           AiUsageLog[]
  decidedApplications   AdmissionApplication[]
  auditLogs             AuditLog[]               @relation("AuditActor")
  decidedRegistrations  RegistrationRequest[]    @relation("RegistrationDecider")
  activationTokens    ActivationToken[]
  reviewedInsights      IntelligenceInsight[]    @relation("InsightReviewer")
  decidedLeaves         LeaveRequest[]         @relation("LeaveDecider")
  markedStaffAttendance StaffAttendance[]      @relation("StaffAttendanceMarker")
  approvedDiscounts     Discount[]             @relation("DiscountApprover")
  createdEvents         SchoolEvent[]          @relation("EventCreator")
  generatedPayslips     Payslip[]              @relation("PayslipGenerator")
  requestedExpenses     ExpenseRequest[]       @relation("ExpenseRequester")
  decidedExpenses       ExpenseRequest[]       @relation("ExpenseDecider")
}

model SessionToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId    String   @unique
  phone         String
  cnic          String?
  hireDate      DateTime
  salaryMonthly Int
  isActive      Boolean  @default(true)

  allocations     SubjectAllocation[]
  timetableSlots  TimetableSlot[]
  classSections   Section[]           @relation("ClassTeacher")
  diaryEntries    DiaryEntry[]
  studyMaterials  StudyMaterial[]
  leaveRequests   LeaveRequest[]
  staffAttendance StaffAttendance[]
  liveClasses     LiveClass[]
  payslips        Payslip[]
}

model StaffMember {
  id            String    @id @default(cuid())
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId    String    @unique
  designation   String
  staffType     StaffType @default(OTHER)
  phone         String
  cnic          String?
  hireDate      DateTime
  salaryMonthly Int
  isActive      Boolean   @default(true)

  leaveRequests   LeaveRequest[]
  staffAttendance StaffAttendance[]
  payslips        Payslip[]
}

model Parent {
  id      String  @id @default(cuid())
  userId  String? @unique
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name    String
  phone   String
  cnic    String?
  address String?

  children StudentParent[]
}

model Student {
  id          String          @id @default(cuid())
  admissionNo String          @unique
  name        String
  dob         DateTime?
  gender      String?
  bForm       String?
  gradeId     String
  grade       Grade           @relation(fields: [gradeId], references: [id])
  sectionId   String
  section     Section         @relation(fields: [sectionId], references: [id])
  shiftId     String
  shift       Shift           @relation(fields: [shiftId], references: [id])
  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  address     String?
  photoUrl    String?
  isActive    Boolean         @default(true)

  parents          StudentParent[]
  gateCheckIns     GateCheckIn[]
  gateCheckOuts    GateCheckOut[]
  periodAttendance PeriodAttendance[]
  conflicts        AttendanceConflict[]
  examResults      ExamResult[]
  vouchers         FeeVoucher[]
  notifications    NotificationLog[]
  leaveRequests    LeaveRequest[]
  discounts        Discount[]
}

model StudentParent {
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String  @default("Guardian")

  @@id([studentId, parentId])
}

// ── Academics ────────────────────────────────────────────────────────────

model Grade {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level    Int
  name     String

  sections              Section[]
  students              Student[]
  allocations           SubjectAllocation[]
  examSchedules         ExamSchedule[]
  feeHeads              FeeHead[]
  studyMaterials        StudyMaterial[]
  admissionApplications AdmissionApplication[]
  schoolEvents          SchoolEvent[]
  registrationRequests  RegistrationRequest[]
}

model Section {
  id             String   @id @default(cuid())
  gradeId        String
  grade          Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name           String
  room           String?
  classTeacherId String?
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  students         Student[]
  timetableSlots   TimetableSlot[]
  periodAttendance PeriodAttendance[]
  diaryEntries     DiaryEntry[]
  studyMaterials   StudyMaterial[]
  liveClasses      LiveClass[]
  registrationRequests RegistrationRequest[]
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String

  allocations      SubjectAllocation[]
  timetableSlots   TimetableSlot[]
  examSchedules    ExamSchedule[]
  periodAttendance PeriodAttendance[]
  diaryEntries     DiaryEntry[]
  studyMaterials   StudyMaterial[]
  liveClasses      LiveClass[]
}

model SubjectAllocation {
  id             String  @id @default(cuid())
  subjectId      String
  subject        Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeId        String
  grade          Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  periodsPerWeek Int

  @@unique([subjectId, gradeId])
}

model TimetableSlot {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sun … 6=Sat
  periodNo  Int
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room      String?
  startTime String // "HH:MM"
  endTime   String

  @@unique([sectionId, dayOfWeek, periodNo])
}

model ExamTerm {
  id        String          @id @default(cuid())
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime

  schedules ExamSchedule[]
}

model ExamSchedule {
  id         String   @id @default(cuid())
  examTermId String
  examTerm   ExamTerm @relation(fields: [examTermId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeId    String
  grade      Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  date       DateTime
  startTime  String
  totalMarks Int

  results ExamResult[]
}

model ExamResult {
  id             String       @id @default(cuid())
  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  obtainedMarks  Int
  remarks        String?

  @@unique([examScheduleId, studentId])
}

// ── Dual-tier attendance ─────────────────────────────────────────────────

model GateCheckIn {
  id          String             @id @default(cuid())
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD (PKT)
  checkInTime DateTime
  method      CheckInMethod
  terminalId  String?
  terminal    BiometricTerminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?              @relation("GateCheckInCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
}

model GateCheckOut {
  id           String             @id @default(cuid())
  studentId    String
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         String
  checkOutTime DateTime
  method       CheckInMethod
  terminalId   String?
  terminal     BiometricTerminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
}

model PeriodAttendance {
  id         String           @id @default(cuid())
  sectionId  String
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD (PKT)
  periodNo   Int
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime         @default(now())

  @@unique([sectionId, subjectId, date, periodNo, studentId])
  @@index([sectionId, date])
  @@index([studentId, date])
  @@index([markedById, date])
}

model AttendanceConflict {
  id           String         @id @default(cuid())
  date         String
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         ConflictType
  status       ConflictStatus @default(OPEN)
  note         String?
  resolvedById String?
  resolvedBy   User?          @relation("ConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@unique([date, studentId, type])
}

// ── Finance ──────────────────────────────────────────────────────────────

model FeeHead {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  defaultAmount Int // minor units (PKR rupees)
  gradeId       String?
  grade         Grade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  voucherLines FeeVoucherLine[]
}

model FeeVoucher {
  id             String          @id @default(cuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId      String
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  dueDate        DateTime
  totalAmount    Int
  discountAmount Int             @default(0)
  fineAmount     Int             @default(0)
  status         VoucherStatus   @default(UNPAID)
  issuedAt       DateTime        @default(now())

  lines    FeeVoucherLine[]
  payments Payment[]

  @@unique([studentId, month, year])
}

model FeeVoucherLine {
  id        String     @id @default(cuid())
  voucherId String
  voucher   FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  feeHeadId String
  feeHead   FeeHead    @relation(fields: [feeHeadId], references: [id])
  amount    Int
}

model Payment {
  id           String        @id @default(cuid())
  voucherId    String
  voucher      FeeVoucher    @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amount       Int
  method       PaymentMethod
  reference    String?
  receivedById String?
  receivedBy   User?         @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  paidAt       DateTime      @default(now())
}

model ExpenseHead {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  expenses        Expense[]
  expenseRequests ExpenseRequest[]
  budgets         Budget[]
}

model PaymentSource {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  expenses        Expense[]
  expenseRequests ExpenseRequest[]
}

model Expense {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date           DateTime
  headId         String
  head           ExpenseHead     @relation(fields: [headId], references: [id])
  sourceId       String
  source         PaymentSource   @relation(fields: [sourceId], references: [id])
  amount         Int
  description    String?
  addedById      String?
  addedBy        User?           @relation("ExpenseAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  expenseRequest ExpenseRequest?
}

model Budget {
  id            String          @id @default(cuid())
  schoolId      String
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId     String
  session       AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  headId        String
  head          ExpenseHead     @relation(fields: [headId], references: [id], onDelete: Cascade)
  plannedAmount Int

  @@unique([schoolId, sessionId, headId])
}

// ── Communication ────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  schoolId    String
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  priority    AnnouncementPriority @default(NORMAL)
  audience    AnnouncementAudience @default(ALL)
  gradeId     String?
  createdById String
  createdBy   User                 @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
}

// ── Class diary: what was taught today + classwork/homework ──────────────
// Written by teachers (one entry per section+subject+day), read by students,
// parents, teachers and management. `date` follows the YYYY-MM-DD PKT string
// convention used by PeriodAttendance/GateCheckIn (never a DateTime).
model DiaryEntry {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date        String
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  taughtToday String?
  classwork   String?
  homework    String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sectionId, subjectId, date])
  @@index([sectionId, date])
  @@index([teacherId, date])
  @@index([date])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentId String?
  student   Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  type      NotificationType
  channel   NotificationChannel
  message   String
  status    NotificationStatus  @default(SENT)
  sentAt    DateTime            @default(now())
  readAt    DateTime?
}

model SmsTemplate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  body     String
}

// ── Biometric ────────────────────────────────────────────────────────────

model BiometricTerminal {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  ipAddress     String
  port          Int            @default(4370)
  status        TerminalStatus @default(OFFLINE)
  lastHeartbeat DateTime?

  checkIns  GateCheckIn[]
  checkOuts GateCheckOut[]
}

// ── AI assistant ─────────────────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT
  content        String
  toolsUsed      String?
  createdAt      DateTime       @default(now())
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  intent    String
  provider  String   @default("rule-based")
  latencyMs Int
  createdAt DateTime @default(now())
}

// ── Phase 2: study materials + admissions ──────────────────────────────────
enum MaterialType {
  NOTE
  WORKSHEET
  PAST_PAPER
  VIDEO_LINK
  AUDIO_LINK
}

model StudyMaterial {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeId     String?
  grade       Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  sectionId   String?
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String?
  type        MaterialType
  createdAt   DateTime     @default(now())

  @@index([schoolId, subjectId])
  @@index([gradeId])
  @@index([teacherId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdmissionApplication {
  id          String            @id @default(cuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  dob         DateTime?
  gender      String?
  gradeId     String
  grade       Grade             @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  parentName  String
  parentPhone String
  address     String?
  status      ApplicationStatus @default(PENDING)
  decidedById String?
  decidedBy   User?             @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([schoolId, status])
}

// ── Phase 3: leave, staff attendance, discounts, events, live classes ──────
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  fromDate      String
  toDate        String
  reason        String
  status        LeaveStatus  @default(PENDING)
  decidedById   String?
  decidedBy     User?        @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([schoolId, status])
  @@index([studentId])
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

model StaffAttendance {
  id            String                @id @default(cuid())
  schoolId      String
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Teacher?              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember?          @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  date          String
  status        StaffAttendanceStatus
  note          String?
  markedById    String
  markedBy      User                  @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())

  @@unique([teacherId, staffMemberId, date])
  @@index([schoolId, date])
}

enum DiscountType {
  SIBLING
  STAFF_WARD
  MERIT
  NEED_BASED
  OTHER
}

model Discount {
  id           String       @id @default(cuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         DiscountType
  percent      Int?
  amount       Int?
  reason       String?
  approvedById String
  approvedBy   User         @relation("DiscountApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())

  @@index([studentId])
}

model FeePolicy {
  id            String   @id @default(cuid())
  schoolId      String   @unique
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fineGraceDays Int      @default(10)
  finePerDay    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model SchoolEvent {
  id          String               @id @default(cuid())
  schoolId    String
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  audience    AnnouncementAudience @default(ALL)
  gradeId     String?
  grade       Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  venue       String?
  createdById String
  createdBy   User                 @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  @@index([schoolId, date])
}

model LiveClass {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title      String
  meetingUrl String
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())

  @@index([schoolId, startsAt])
  @@index([sectionId])
}

// ── Phase 4: payroll, expense approvals ────────────────────────────────────
enum PayslipStatus {
  DRAFT
  GENERATED
  PAID
}

model Payslip {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Teacher?      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember?  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  baseSalary    Int
  allowances    Int           @default(0)
  deductions    Int           @default(0)
  netPay        Int
  status        PayslipStatus @default(GENERATED)
  generatedById String
  generatedBy   User          @relation("PayslipGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([schoolId, year, month])
  @@index([teacherId])
  @@index([staffMemberId])
}

enum ExpenseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ExpenseRequest {
  id            String               @id @default(cuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                 @relation("ExpenseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  title         String
  description   String?
  amount        Int
  headId        String
  head          ExpenseHead          @relation(fields: [headId], references: [id], onDelete: Restrict)
  status        ExpenseRequestStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?                @relation("ExpenseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  sourceId      String?
  source        PaymentSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  expenseId     String?              @unique
  expense       Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@index([schoolId, status])
}

// ── Identity, audit & intelligence ────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. ACCOUNT_CREATED, PASSWORD_RESET, STUDENT_RECORD_VIEWED
  targetType String? // e.g. User, Student, Payroll
  targetId  String?
  result    String   @default("ALLOWED") // ALLOWED | DENIED
  detail    String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}

model RegistrationRequest {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName      String
  accountType   Role
  phone         String
  email         String?
  admissionNo   String?
  gradeId       String?
  grade         Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  guardianName  String?
  guardianPhone String?
  notes         String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | CORRECTION_REQUIRED
  decidedById   String?
  decidedBy     User?    @relation("RegistrationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdUserId String?  // User id created on approval
  createdAt     DateTime @default(now())

  @@index([schoolId, status])
}

model IntelligenceInsight {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    String   // ATTENTION | OPPORTUNITY | POSITIVE | OPTIMIZATION | PERMISSION
  title       String
  explanation String
  evidence    String?
  period      String?
  confidence  String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  // Structured suggested action (JSON): { action, owner, dueDate }
  suggestedAction String?
  status      String   @default("NEW") // NEW | REVIEWED | DISMISSED | IMPLEMENTED
  // Human review
  reviewedById String?
  reviewedBy  User?    @relation("InsightReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?
  reviewerNotes String?
  // Decision / outcome / measurement loop
  decision    String?  // APPROVED | REJECTED | DEFERRED
  decidedAt   DateTime?
  outcome     String?  // What happened after implementation
  measuredAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, status])
}

model ActivationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 of the raw token; raw token never stored
  purpose   String   @default("ACTIVATION") // ACTIVATION | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
